    function library:refresh_notifications()
        for i, notif in next, library.notifications do 
            -- Stack upwards from bottom
            -- i=1 is at bottom (offset 0), i=2 is above it (offset 28), etc.
            local targetPos = UDim2.new(0, 0, 1, -(i * 30))
            tween_service:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {Position = targetPos}):Play()
        end     
    end

    function library:notification(properties)
        local cfg = {
            time = properties.time or 5,
            text = properties.text or properties.name or "Notification",
        }
    
        local _, count = string.gsub(cfg.text, "\n", "")
        local height = 22 + (count * 13) -- Compact height

        local notif_holder = library.notif_holder 
        
        -- Try to find existing holder
        if not notif_holder then
             local sg = gethui and gethui() or coregui
             for _, v in pairs(sg:GetChildren()) do
                 if v:IsA("ScreenGui") and v:FindFirstChild("notif_holder") then
                     notif_holder = v.notif_holder
                     break
                 end
             end
        end

        -- Create holder if missing
        if not notif_holder then
            local sg = library:create("ScreenGui", {
                Parent = gethui and gethui() or coregui,
                Name = "TraeNotificationGui",
                ZIndexBehavior = Enum.ZIndexBehavior.Sibling
            })
            
            -- Prevent main UI toggle from hiding this
            local idx = table.find(library.guis, sg)
            if idx then table.remove(library.guis, idx) end
            
            notif_holder = library:create("Frame", {
                Parent = sg,
                Name = "notif_holder",
                BackgroundTransparency = 1
            })
        end

        if not notif_holder then return end 
        
        -- Enforce Bottom-Middle Position
        notif_holder.AnchorPoint = Vector2.new(0.5, 1) -- Bottom Center
        notif_holder.Position = UDim2.new(0.5, 0, 1, -50) -- Standard bottom padding
        notif_holder.Size = UDim2.new(0, 220, 0.5, 0) -- Back to 220px width
        library.notif_holder = notif_holder

        -- Create the notification frame (OUTLINE)
        local notif_frame = library:create("Frame", {
            Parent = notif_holder,
            Name = "Notification",
            Size = UDim2.new(1, 0, 0, height),
            BorderColor3 = rgb(0, 0, 0),
            BorderSizePixel = 0,
            Position = UDim2.new(0, 0, 1, 30), 
            BackgroundColor3 = themes.preset.outline, -- Outer border color
            ZIndex = 10
        })
        library:apply_theme(notif_frame, "outline", "BackgroundColor3")

        -- Inner Frame (INLINE)
        local inline = library:create("Frame", {
            Parent = notif_frame,
            Name = "Inline",
            Position = UDim2.new(0, 1, 0, 1),
            Size = UDim2.new(1, -2, 1, -2),
            BorderSizePixel = 0,
            BackgroundColor3 = themes.preset.inline, -- Middle border color
            ZIndex = 11
        })
        library:apply_theme(inline, "inline", "BackgroundColor3")

        -- Content Frame (BACKGROUND)
        local content = library:create("Frame", {
            Parent = inline,
            Name = "Content",
            Position = UDim2.new(0, 1, 0, 1),
            Size = UDim2.new(1, -2, 1, -2),
            BorderSizePixel = 0,
            BackgroundColor3 = rgb(255, 255, 255), -- White for gradient
            ZIndex = 12
        })
        
        -- Add Gradient to match UI style
        local UIGradient = library:create("UIGradient", {
            Parent = content,
            Rotation = 90,
            Color = rgbseq{
                rgbkey(0, rgb(41, 41, 55)),
                rgbkey(1, rgb(35, 35, 47))
            }
        })
        library:apply_theme(UIGradient, "contrast", "Color")
        
        -- Accent Bar (Left side, Sharp)
        local accent = library:create("Frame", {
            Parent = content,
            Name = "Accent",
            Position = UDim2.new(0, 0, 0, 0),
            Size = UDim2.new(0, 2, 1, 0),
            BorderSizePixel = 0,
            BackgroundColor3 = themes.preset.accent,
            ZIndex = 13
        }) 
        library:apply_theme(accent, "accent", "BackgroundColor3")
        
        -- Text
        local label = library:create("TextLabel", {
            Parent = content,
            Name = "Text",
            FontFace = library.font, -- Revert to library font
            TextColor3 = themes.preset.text,
            Text = cfg.text,
            Size = UDim2.new(1, -12, 1, 0),
            Position = UDim2.new(0, 8, 0, 0), -- 8px padding from left (2px accent + 6px space)
            BackgroundTransparency = 1,
            TextSize = 13, -- Smaller text
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Center,
            TextWrapped = true,
            ZIndex = 13
        })
        
        -- Add shadow to text for readability
        library:create("UIStroke", {
            Parent = label,
            Color = rgb(0,0,0),
            Thickness = 1,
            Transparency = 0.5
        })
        
        -- Add to stack
        local index = #library.notifications + 1
        library.notifications[index] = notif_frame

        -- Animate In
        library:refresh_notifications() -- This will tween it to correct slot

        -- Auto Destroy
        task.spawn(function()
            task.wait(cfg.time)
            
            -- Remove from table first so others re-stack
            local idx = table.find(library.notifications, notif_frame)
            if idx then
                table.remove(library.notifications, idx)
            end
            
            library:refresh_notifications()

            -- Animate Out (Fade & Drop)
            local outInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            tween_service:Create(notif_frame, outInfo, {
                Position = notif_frame.Position + UDim2.new(0, 50, 0, 0), -- Slide right
                BackgroundTransparency = 1
            }):Play()
            
            for _, v in ipairs(notif_frame:GetDescendants()) do
                if v:IsA("GuiObject") then
                    if v:IsA("TextLabel") then
                         tween_service:Create(v, outInfo, {TextTransparency = 1}):Play()
                    elseif v:IsA("UIStroke") then
                         tween_service:Create(v, outInfo, {Transparency = 1}):Play()
                    else
                         tween_service:Create(v, outInfo, {BackgroundTransparency = 1}):Play()
                    end
                end
            end

            task.wait(0.6)
            notif_frame:Destroy()
        end)    
    end 

