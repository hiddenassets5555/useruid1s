    backgroundCircle.BackgroundTransparency = 1
    backgroundCircle.Image = "rbxassetid://3570695787" -- Circle asset
    backgroundCircle.ImageColor3 = Color3.fromRGB(0, 0, 0)
    backgroundCircle.ImageTransparency = 0.5
    backgroundCircle.Visible = false
    backgroundCircle.ZIndex = 9
    backgroundCircle.Parent = screenGui

    local imageIndicator = Instance.new("ImageLabel")
    imageIndicator.Name = "Desync Indicator"
    imageIndicator.Size = UDim2.new(0, 20, 0, 20)
    imageIndicator.AnchorPoint = Vector2.new(0.5, 0.5)
    imageIndicator.Position = UDim2.new(0.5, 0, 0.5, 0)
    imageIndicator.BackgroundTransparency = 1
    imageIndicator.Image = "rbxassetid://10723415903" -- Material Person Icon
    imageIndicator.ImageTransparency = 0
    imageIndicator.Visible = false
    imageIndicator.ZIndex = 10
    imageIndicator.Parent = screenGui

    local desyncInfoItem = nil
    local autoDesyncActive = false

    local CurrentServerCFrame = nil

    local currentRelativeCFrame = CFrame.new(0, 0, 0)

    -- Store connection for cleanup
    local heartbeatConn = run.Heartbeat:Connect(function(dt)
        local enabled = library.flags["desync_server"]
        local char = lp.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        
        if not root then
            library.DesyncData.RealCFrame = nil
            CurrentServerCFrame = nil
            return
        end
        
        if not enabled then
            library.DesyncData.RealCFrame = nil
            CurrentServerCFrame = root.CFrame
            currentRelativeCFrame = CFrame.new(0, 0, 0)
            
            if library.remove_info_item then
                library:add_info_item("Desync Status", "Disabled", Color3.fromRGB(255, 0, 0))
                library:remove_info_item("Desync Mode")
                library:remove_info_item("Desync Offset")
                library:remove_info_item("Detected")
                if library.info_list_frame then
                    library.info_list_frame.Visible = true
                end
            end

            return 
        end

        -- Auto-disable desync when aiming with a tool
        local tool = char:FindFirstChildWhichIsA("Tool")
        if tool and uis:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) and not autoDesyncActive then
            library.DesyncData.RealCFrame = nil
            CurrentServerCFrame = root.CFrame
            currentRelativeCFrame = CFrame.new(0, 0, 0)
            return
        end

        -- Calculate Target Relative CFrame
        local targetRelative = CFrame.Identity
        local mode = library.flags["desync_mode"] or "Custom"
        
        if mode == "Underground" then
            local worldOffset = Vector3.new(0, -10, 0)
            local targetPos = root.Position + worldOffset
            local absRot = CFrame.Angles(0, 0, math.rad(180))
            targetRelative = root.CFrame:Inverse() * (CFrame.new(targetPos.X, targetPos.Y, targetPos.Z) * absRot)
        elseif mode == "SCP" then
            local xOffset = 0
            local yOffset = 0 -- Default to 0 (Normal Position) when no SCP detected
            local zOffset = 0
            
            if library.DesyncData.DetectedSCP then
                if library.DesyncData.Has076 then
                    xOffset = -17
                    yOffset = -15
                    zOffset = 11
                elseif library.DesyncData.Has066 then
                    xOffset = -17
                    yOffset = -30
                    zOffset = 11
                    if library.DesyncData.DetectedSCP == "Multiple" then
                        zOffset = 20
                    end
                elseif library.DesyncData.DetectedSCP == "Multiple" then
                    yOffset = -15
                    zOffset = 20
                else
                     yOffset = -15 -- Default for single non-066 SCP? Or keep 0? User didn't specify single non-066. 
                     -- Assuming standard single SCP behavior is needed. Previous code had -30 as default.
                     -- User said: "when detect scp 066 make it -100 and for multiple will be - 75".
                     -- Implies specific overrides.
                     -- I will keep -30 for single generic SCP if that was the intent, but user said "go back to normal position" when NO scps.
                     -- So if DetectedSCP is present but NOT 066 and NOT Multiple, what should it be?
                     -- I'll stick to -30 for single generic SCP, and 0 for NO SCP.
                     yOffset = -15
                end
            end
            
            local worldOffset = Vector3.new(xOffset, yOffset, zOffset)
            local targetPos = root.Position + worldOffset
            local absRot = CFrame.Angles(0, 0, math.rad(180))
            targetRelative = root.CFrame:Inverse() * (CFrame.new(targetPos.X, targetPos.Y, targetPos.Z) * absRot)
        else -- Custom
             local x = tonumber(library.flags["desync_offset_x"]) or 0
             local y = tonumber(library.flags["desync_offset_y"]) or 0
             local z = tonumber(library.flags["desync_offset_z"]) or 0
             local posOffset = Vector3.new(x, y, z)
             
             local p = tonumber(library.flags["desync_rot_pitch"]) or 0
             local yaw = tonumber(library.flags["desync_rot_yaw"]) or 0
             local r = tonumber(library.flags["desync_rot_roll"]) or 0
             
             local rotOffset = CFrame.Angles(math.rad(p), math.rad(yaw), math.rad(r))
             
             targetRelative = CFrame.new(posOffset.X, posOffset.Y, posOffset.Z) * rotOffset
        end

        -- Smooth Transition
        if not currentRelativeCFrame then currentRelativeCFrame = CFrame.new(0, 0, 0) end
        if dt then
            currentRelativeCFrame = currentRelativeCFrame:Lerp(targetRelative, math.min(dt * 2, 1))
        else
            currentRelativeCFrame = targetRelative
        end

        local ServerCFrame = root.CFrame * currentRelativeCFrame
        CurrentServerCFrame = ServerCFrame
        library.DesyncData.RealCFrame = root.CFrame
        root.CFrame = ServerCFrame

        if library.add_info_item then
             if enabled then
                 library:add_info_item("Desync Status", "Enabled", Color3.fromRGB(0, 255, 0))
                 library:add_info_item("Desync Mode", mode)
                 
                 local relPos = currentRelativeCFrame.Position
                 library:add_info_item("Desync Offset", string.format("%.1f, %.1f, %.1f", relPos.X, relPos.Y, relPos.Z))
             end
        end
    end)
    table.insert(getgenv().ScriptCleanup, heartbeatConn)

    
    local ghostChar = nil
    local smoothedGhostCFrame = nil
    local ghostPartCache = {} -- [RealPart] = GhostPart
    local lastChar = nil
    
    run:BindToRenderStep("DesyncGhostUpdate", Enum.RenderPriority.Camera.Value - 1, function(dt)
        local char = lp.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        
        -- Reset cache on respawn
        if char ~= lastChar then
            ghostPartCache = {}
            if ghostChar then ghostChar:Destroy() ghostChar = nil end
            lastChar = char
        end
        
        -- Restore RealCFrame
        if library.DesyncData.RealCFrame and root then
            root.CFrame = library.DesyncData.RealCFrame
        end
        
        -- Calculate Live Server CFrame (Smoother)
        local liveServerCFrame = nil
        if root and currentRelativeCFrame then
             liveServerCFrame = root.CFrame * currentRelativeCFrame
        elseif CurrentServerCFrame then
             liveServerCFrame = CurrentServerCFrame
        end

        -- Apply extra smoothing to match Indicator (dt * 15)
        if liveServerCFrame then
            if not smoothedGhostCFrame then 
                smoothedGhostCFrame = liveServerCFrame 
            end
            smoothedGhostCFrame = smoothedGhostCFrame:Lerp(liveServerCFrame, math.clamp(dt * 15, 0, 1))
        else
            smoothedGhostCFrame = nil
        end

        -- HRP Visualizer (Now Ghost Character)
        if library.flags["desync_visualize"] and library.flags["desync_visualize_hrp"] and smoothedGhostCFrame and root and char then
             if not ghostChar or not ghostChar.Parent then
                 -- Create Ghost Character Folder
                 ghostChar = Instance.new("Folder")
                 ghostChar.Name = "DesyncGhost"
                 ghostChar.Parent = workspace
                 -- If ghostChar was recreated, we must clear cache references to invalid parts
                 ghostPartCache = {}
             end

             local visColor = library.flags["desync_visualize_color"]
             if typeof(visColor) == "table" and visColor.Color then visColor = visColor.Color end
             visColor = visColor or Color3.fromRGB(227, 144, 191)

             -- Update Ghost Parts
             local currentFrameParts = {}
             local matEnum = Enum.Material.ForceField
             if library.flags["desync_hrp_material"] == "Neon" then
                matEnum = Enum.Material.Neon
             end

             for _, part in pairs(char:GetDescendants()) do
                local isAccessory = part:FindFirstAncestorWhichIsA("Accessory")
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and not part:FindFirstAncestorWhichIsA("Tool") and (matEnum ~= Enum.Material.Neon or not isAccessory) then
                    -- Mark as valid for this frame
                    currentFrameParts[part] = true
                    
                    local ghostPart = ghostPartCache[part]
                    
                    if not ghostPart or not ghostPart.Parent then
                         ghostPart = part:Clone()
                         ghostPart.Name = part.Name -- Name doesn't matter for collision now, but good for debug
                         ghostPart.Parent = ghostChar
                         ghostPart.Anchored = true
                         ghostPart.CanCollide = false
                         ghostPart.CanTouch = false
                         ghostPart.CanQuery = false
                         ghostPart.Massless = true
                         ghostPart.Material = matEnum
                         ghostPart.Color = visColor
                         ghostPart.Transparency = 0.5
                         
                         -- Remove Scripts, Joints, Constraints, Decals (Faces), GUIs (NameTags), Textures
                        for _, child in pairs(ghostPart:GetChildren()) do
                            if child:IsA("LocalScript") or child:IsA("Script") or child:IsA("JointInstance") or child:IsA("Weld") or child:IsA("Constraint") or child:IsA("Decal") or child:IsA("Texture") or child:IsA("BillboardGui") or child:IsA("SurfaceGui") or child:IsA("ScreenGui") then
                                child:Destroy()
                            end
                        end
                        
                        -- Cache it
                        ghostPartCache[part] = ghostPart
                     end
                     
                     -- Ensure collision properties are enforced every frame just in case
                     ghostPart.CanCollide = false
                     ghostPart.CanTouch = false
                     ghostPart.CanQuery = false
                     
                     -- Calculate Server Position for this part
                     -- ServerRoot * (RealRoot:Inverse() * RealPart)
                     local relCFrame = root.CFrame:Inverse() * part.CFrame
                     ghostPart.CFrame = smoothedGhostCFrame * relCFrame
                     ghostPart.Color = visColor
                     ghostPart.Material = matEnum
                     ghostPart.Transparency = 0.6
                 end
             end
             
             -- Cleanup old parts (mark and sweep)
             for realPart, ghostPart in pairs(ghostPartCache) do
                 if not currentFrameParts[realPart] then
                     if ghostPart then ghostPart:Destroy() end
                     ghostPartCache[realPart] = nil
                 end
             end
             
        else
            if ghostChar then
                ghostChar:Destroy()
                ghostChar = nil
                ghostPartCache = {}
            end
        end

        -- Update Indicator
        -- local enabled = library.flags["desync_server"] -- Removed to allow visualization when disabled
        local visualize = library.flags["desync_visualize"] and library.flags["desync_visualize_indicator"]
        local camera = ws.CurrentCamera

        if not visualize or not root or not liveServerCFrame or not camera then
            imageIndicator.Visible = false
            backgroundCircle.Visible = false
            smoothedPos = nil
            return
        end

        -- Visualization Logic
        local targetPos = liveServerCFrame.Position
        
        -- Attempt to find Torso offset
        local torso = char and char:FindFirstChild("Torso")
        if torso and not torso:IsA("BasePart") then torso = nil end
        if not torso and char then torso = char:FindFirstChild("UpperTorso") end
        if torso and not torso:IsA("BasePart") then torso = nil end

        if torso and root then
             -- Calculate relative offset of Torso from Root in Object Space
             local relCFrame = root.CFrame:ToObjectSpace(torso.CFrame)
             -- Apply that offset to the CurrentServerCFrame
             targetPos = liveServerCFrame:ToWorldSpace(relCFrame).Position
        else
             -- Fallback approximate offset if Torso not found (approx 2.5 studs up relative to root)
             targetPos = liveServerCFrame:ToWorldSpace(CFrame.new(0, 2.5, 0)).Position
        end

        if not smoothedPos then
            if torso then
                smoothedPos = torso.Position
            elseif root then
                smoothedPos = root.CFrame:ToWorldSpace(CFrame.new(0, 2.5, 0)).Position
            else
                smoothedPos = targetPos
            end
        end

        -- Lerp the position
        local lerpSpeed = 15
        
        local enabled = library.flags["desync_server"]
        -- if not enabled then
        --      -- Increase lerp speed when disabled to snap back faster
        --      lerpSpeed = 25
        -- end

        smoothedPos = smoothedPos:Lerp(targetPos, math.clamp(dt * lerpSpeed, 0, 1))

        local screen_pos, on_screen = camera:WorldToViewportPoint(smoothedPos)
        
        if on_screen and screen_pos.Z > 0 then
            local pos = UDim2.new(0, screen_pos.X, 0, screen_pos.Y)
            imageIndicator.Position = pos
            backgroundCircle.Position = pos
            
            -- Rotation Logic (Visualizes Server Rotation)
            local _, yaw, _ = liveServerCFrame:ToEulerAnglesYXZ()
            local _, camYaw, _ = camera.CFrame:ToEulerAnglesYXZ()
            local relativeYaw = yaw - camYaw
            imageIndicator.Rotation = math.deg(-relativeYaw)
            
            local screen_x, screen_y = camera.ViewportSize.X, camera.ViewportSize.Y
            local padding = 20
            local in_bounds = screen_pos.X > padding and screen_pos.X < (screen_x - padding) and 
                             screen_pos.Y > padding and screen_pos.Y < (screen_y - padding)
            
            imageIndicator.Visible = in_bounds
            backgroundCircle.Visible = in_bounds

            local visColor = library.flags["desync_visualize_color"]
            if typeof(visColor) == "table" then
                 if visColor.Color then visColor = visColor.Color end
            end
            if typeof(visColor) == "Color3" then
                 imageIndicator.ImageColor3 = visColor
            end
        else
            imageIndicator.Visible = false
            backgroundCircle.Visible = false
        end
    end)
end

