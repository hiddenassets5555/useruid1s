        b.Chams.Enabled = true
        b.Chams.Adornee = char
        b.Chams.FillColor = getColor(flags.esp_chams_c1, Color3.new(1,0,0))
        b.Chams.OutlineColor = getColor(flags.esp_chams_c2, Color3.new(1,1,1))
        
        local fillTrans = 0.5
        if type(flags.esp_chams_c1) == "table" and flags.esp_chams_c1.Transparency then
            fillTrans = 1 - flags.esp_chams_c1.Transparency
        end
        
        local outlineTrans = 0
        if type(flags.esp_chams_c2) == "table" and flags.esp_chams_c2.Transparency then
            outlineTrans = 1 - flags.esp_chams_c2.Transparency
        end

        if flags.esp_chams_thermal then
            local breathe = math.abs(math.sin(tick() * 2))
            b.Chams.FillTransparency = fillTrans * breathe
            b.Chams.OutlineTransparency = outlineTrans * breathe
        else
            b.Chams.FillTransparency = fillTrans
            b.Chams.OutlineTransparency = outlineTrans
        end
    else
        b.Chams.Enabled = false
    end
    
    -- Text Logic
    local fontSize = tonumber(flags.esp_font_size_dummy) or 8
    if fontSize < 5 then fontSize = 5 end -- Safety clamp
    
    local selectedFont = flags.settings_font_dummy or "Minecraft"
