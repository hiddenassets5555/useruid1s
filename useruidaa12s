-- [[ Desync Logic ]]
do

    local oldIndex
    oldIndex = hookmetamethod(game, "__index", function(self, index)
        if not checkcaller() and library.flags["desync_server"] and library.DesyncData.RealCFrame and (index == "CFrame" or index == "Position") then
