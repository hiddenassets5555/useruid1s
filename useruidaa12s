                                local nameText = ESPCache[p].name_text
                                local modTagText = ESPCache[p].mod_tag_text
                                local roleText = ESPCache[p].role_text
                                local distText = ESPCache[p].dist_text
                                
                                
                                local padding = math.max(3, math.floor(ts * 0.35))
                                
                                local showName = (flags.esp_names and not hideESP) or isLocated

                                if showName then
                                    local nPos = Vector2.new(maxX + padding, minY)
                                    
                                    if isLocated then
                                         -- Override nPos for Located players to match Corner Box calculation
                                         -- (Logic from UpdateBronxESP)
                                         local root = p.Character:FindFirstChild("HumanoidRootPart")
                                         if root then
                                            local pos, _ = camera:WorldToScreenPoint(root.Position)
                                            local size = root.Size.Y
                                            local scaleFactor = (size * camera.ViewportSize.Y) / (pos.Z * 2)
                                            local w_box, h_box = 3 * scaleFactor, 4.5 * scaleFactor
                                            
                                            -- Corner Box Top-Right
                                            local boxMaxX = pos.X + w_box / 2
                                            local boxMinY = pos.Y - h_box / 2
                                            
                                            -- Center text block vertically relative to box
                                            -- 3 lines: [Mod], Name, Role
                                            -- Height = 3*ts + 2*spacing = 3*ts + 4
                                            local totalTextHeight = 3 * ts + 4
                                            local yOffset = (h_box - totalTextHeight) / 2
                                            
                                            nPos = Vector2.new(boxMaxX + padding, boxMinY + yOffset)
                                         end
                                    end

                                    if false and not isLocated then
                                        nameText.Visible = false
                                        if modTagText then modTagText.Visible = false end
                                        if roleText then roleText.Visible = false end
                                    else
                                        if isLocated and modTagText and roleText then
                                            local breathe = 0.5 + (0.5 * math.sin(tick() * 5))
                                            
                                            -- 1. [Moderator] (Yellow) -> REMOVED
                                            modTagText.Visible = false

                                            -- Apply same breathing to Corner Boxes (BronxESPCache)
                                            if BronxESPCache[p] then
                                                local b = BronxESPCache[p]
                                                b.LeftTop.BackgroundTransparency = 1 - breathe
                                                b.LeftSide.BackgroundTransparency = 1 - breathe
                                                b.BottomSide.BackgroundTransparency = 1 - breathe
                                                b.BottomDown.BackgroundTransparency = 1 - breathe
                                                b.RightTop.BackgroundTransparency = 1 - breathe
                                                b.RightSide.BackgroundTransparency = 1 - breathe
                                                b.BottomRightSide.BackgroundTransparency = 1 - breathe
                                                b.BottomRightDown.BackgroundTransparency = 1 - breathe
                                            end
                                            
                                            -- Distance (Yellow, Solid) -> REMOVED
                                            if distText then
                                                 distText.Visible = false
                                            end
                                            
                                            -- 2. Username (White) -> REMOVED
                                            nameText.Visible = false
                                            
                                            -- 3. Role (White) -> REMOVED
                                            roleText.Visible = false
                                        else
                                            if modTagText then modTagText.Visible = false end
                                            if roleText then roleText.Visible = false end
                                            
                                            nameText.Position = nPos
                                            nameText.Visible = true
                                            
                                            if doTextUpdate then
                                                nameText.Text = p.Name
                                                nameText.Color = boxColor
                                                nameText.Transparency = 1
                                                nameText.Font = font
                                                nameText.Size = ts
                                            end
                                        end
                                    end
                                else
                                    nameText.Visible = false
                                    if modTagText then modTagText.Visible = false end
                                    if roleText then roleText.Visible = false end
                                end
                                if not isLocated then
                                    if flags.esp_distance_text and not hideESP then
                                        local offsetY = 0
                                        if showName then
                                            offsetY = ts + math.max(1, math.floor(padding * 0.5))
                                        end
                                        local dPos = Vector2.new(maxX + padding, minY + offsetY)
                                        if false then
                                            distText.Visible = false
                                        else
                                            distText.Position = dPos
                                            distText.Visible = true
                                        end
    
                                        if doTextUpdate then
                                            distText.Text = tostring(math.floor(dist)) .. "m"
                                            distText.Color = boxColor
                                            distText.Font = font
                                            distText.Size = ts
                                        end
                                    else
                                        distText.Visible = false
                                    end
                                end
                                
                                ESPCache[p].health_text.Visible = false
                                local hbBack = ESPCache[p].health_back
                                local hbFront = ESPCache[p].health_front
                                local hbBackO = ESPCache[p].health_back_outline
                                local hbFrontO = ESPCache[p].health_front_outline
                                hbBack.Visible = false
                                hbFront.Visible = false
                                if hbBackO then hbBackO.Visible = false end
                                if hbFrontO then hbFrontO.Visible = false end
                            else
                                hidePlayerESP(p, true)
                                -- Do not disable chams here, as they are handled outside
                            end
                    else
                        if dist <= ESPRenderDistance then
                            hidePlayerESP(p, true)
                        else
                            hidePlayerESP(p)
                        end
                        if PlayerChamsCache[p] then PlayerChamsCache[p].Enabled = false end
                        if PlayerLocateAdornmentCache[p] then
                            if typeof(PlayerLocateAdornmentCache[p]) == "table" then
                                for _, a in pairs(PlayerLocateAdornmentCache[p]) do a.Visible = false end
                            else
                                PlayerLocateAdornmentCache[p].Visible = false
                            end
                        end
                    end
                else
                    hidePlayerESP(p)
                    if PlayerChamsCache[p] then PlayerChamsCache[p].Enabled = false end
                    if PlayerLocateAdornmentCache[p] then
                        if typeof(PlayerLocateAdornmentCache[p]) == "table" then
                            for _, a in pairs(PlayerLocateAdornmentCache[p]) do a.Visible = false end
                        else
                            PlayerLocateAdornmentCache[p].Visible = false
                        end
                    end
                end
            elseif ESPCache[p] then
                hidePlayerESP(p)
                if PlayerChamsCache[p] then PlayerChamsCache[p].Enabled = false end
                if PlayerLocateAdornmentCache[p] then
                    if typeof(PlayerLocateAdornmentCache[p]) == "table" then
                        for _, a in pairs(PlayerLocateAdornmentCache[p]) do a.Visible = false end
                    else
                        PlayerLocateAdornmentCache[p].Visible = false
                    end
                end
            end
        end
    else
        
        for _, p in ipairs(players:GetPlayers()) do
            if ESPCache[p] then
                hidePlayerESP(p)
                if PlayerChamsCache[p] then PlayerChamsCache[p].Enabled = false end
                if PlayerLocateAdornmentCache[p] then
                    if typeof(PlayerLocateAdornmentCache[p]) == "table" then
                        for _, a in pairs(PlayerLocateAdornmentCache[p]) do a.Visible = false end
                    else
                        PlayerLocateAdornmentCache[p].Visible = false
                    end
                end
            end
        end
    end
end)

