end

-- Fix 1: Notification sizing and positioning (Bottom Pop-up)
function library:refresh_notifications()
    for i, notif in next, library.notifications do 
        -- Stack upwards from bottom
        -- i=1 is at bottom (offset 0), i=2 is above it (offset 28), etc.
        local targetPos = UDim2.new(0, 0, 1, -(i * 30))
        tween_service:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out), {Position = targetPos}):Play()
    end     
end

library.notification = function(self, properties)
    local cfg = {
        time = properties.time or 5,
        text = properties.text or properties.name or "Notification",
    }

    local _, count = string.gsub(cfg.text, "\n", "")
    local height = 24 + (count * 14)

    local notif_holder = library.notif_holder 
    
    -- Try to find existing holder
    if not notif_holder then
            local sg = gethui and gethui() or coregui
            for _, v in pairs(sg:GetChildren()) do
                if v:IsA("ScreenGui") and v:FindFirstChild("notif_holder") then
                    notif_holder = v.notif_holder
                    break
                end
            end
    end

    -- Create holder if missing
    if not notif_holder then
        local sg = Instance.new("ScreenGui")
        sg.Name = "TraeNotificationGui"
        sg.Parent = gethui and gethui() or coregui
        sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        
        notif_holder = Instance.new("Frame")
        notif_holder.Name = "notif_holder"
        notif_holder.Parent = sg
        notif_holder.BackgroundTransparency = 1
    end

    if not notif_holder then return end 
    
    -- Enforce Bottom-Middle Position
    notif_holder.AnchorPoint = Vector2.new(0.5, 1) -- Bottom Center
    notif_holder.Position = UDim2.new(0.5, 0, 1, -50) -- 50px padding from bottom screen edge
    notif_holder.Size = UDim2.new(0, 240, 0.5, 0) -- Width 240, Height 50% of screen
    library.notif_holder = notif_holder

    local themes = library.themes

    -- Create the notification frame
    local notif_frame = library:create("Frame", {
        Parent = notif_holder,
        Name = "Notification",
        Size = UDim2.new(1, 0, 0, height), -- Full width of holder
        BorderColor3 = rgb(0, 0, 0),
        BorderSizePixel = 0,
        -- Start Position: Below the first slot (pop up effect)
        Position = UDim2.new(0, 0, 1, 30), 
        BackgroundColor3 = themes.preset.high_contrast, 
        ZIndex = 10
    })
    
    -- Accent Bar (Left side)
    local accent = library:create("Frame", {
        Parent = notif_frame,
        Name = "Accent",
        Position = UDim2.new(0, 0, 0, 0),
        Size = UDim2.new(0, 2, 1, 0),
        BorderSizePixel = 0,
        BackgroundColor3 = themes.preset.accent,
        ZIndex = 12
    }) library:apply_theme(accent, "accent", "BackgroundColor3")
    
    -- Inner Styling
    local bg = library:create("Frame", {
        Parent = notif_frame,
        Name = "BG",
        Position = UDim2.new(0, 2, 0, 0),
        Size = UDim2.new(1, -2, 1, 0),
        BorderSizePixel = 0,
        BackgroundColor3 = themes.preset.high_contrast, -- Dark background
        ZIndex = 11
    })
    
    -- Gradient for BG
    local grad = library:create("UIGradient", {
        Parent = bg,
        Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, themes.preset.high_contrast),
            ColorSequenceKeypoint.new(1, themes.preset.low_contrast)
        },
        Rotation = 45
    })

    -- Text
    local label = library:create("TextLabel", {
        Parent = bg,
        Name = "Text",
        FontFace = library.watermark_font or library.font,
        TextColor3 = themes.preset.text,
        Text = cfg.text,
        Size = UDim2.new(1, -10, 1, 0),
        Position = UDim2.new(0, 10, 0, 0), -- Left padding
        BackgroundTransparency = 1,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 13
    })
    
    -- Add to stack
    local index = #library.notifications + 1
    library.notifications[index] = notif_frame

    -- Animate In
    library:refresh_notifications() -- This will tween it to correct slot

    -- Auto Destroy
    task.spawn(function()
        task.wait(cfg.time)
        
        -- Remove from table first so others re-stack
        local idx = table.find(library.notifications, notif_frame)
        if idx then
            table.remove(library.notifications, idx)
        end
        
        library:refresh_notifications()

        -- Animate Out (Fade & Drop)
        local outInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        tween_service:Create(notif_frame, outInfo, {
            Position = notif_frame.Position + UDim2.new(0, 50, 0, 0), -- Slide right
            BackgroundTransparency = 1
        }):Play()
        
        for _, v in ipairs(notif_frame:GetDescendants()) do
            if v:IsA("GuiObject") then
                if v:IsA("TextLabel") then
                        tween_service:Create(v, outInfo, {TextTransparency = 1}):Play()
                else
                        tween_service:Create(v, outInfo, {BackgroundTransparency = 1}):Play()
                end
            end
        end

        task.wait(0.6)
        notif_frame:Destroy()
    end)    
end 

-- Fix 2: Hook toggle for security
if library.toggle then
    local original_toggle = library.toggle
    library.toggle = function(self, options)
        local cfg = original_toggle(self, options)
        local original_set = cfg.set
        
        cfg.set = function(bool)
            if bool and library.can_enable_feature and not library.can_enable_feature() then
                library:notification({
                    text = "Cannot enable features\nwhile staff is present!",
                    time = 3
                })
                -- Force off visually and logically
                if original_set then original_set(false) end
                return
            end
            if original_set then return original_set(bool) end
        end
        
        -- Update bulk-control reference
        if library.config_flags and cfg.flag then
            library.config_flags[cfg.flag] = cfg.set
        end
        
        return cfg
    end
end

