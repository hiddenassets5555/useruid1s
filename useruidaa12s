        -- Function to update box position based on character bounds (like actual player ESP)
        cfg.updateBoxPosition = function()
            local objs = cfg.objects
            if not cfg.character_model or not objs or not objs["box_handler"] or not objs["holder"] then return end
            
            -- Only update if holder is visible (parented to viewportframe, not cache)
            if objs["holder"].Parent == library.cache then return end
            
            local character = cfg.character_model
            local camera = items.camera
            if not character or not camera then return end
            
            local root = character:FindFirstChild("HumanoidRootPart")
            if not root then return end
            
            -- Get actual game camera viewport size (CRITICAL: must use game camera, not preview viewport size!)
            local currentCamera = workspace.CurrentCamera
            local gameViewportSize = currentCamera and currentCamera.ViewportSize or Vector2.new(1920, 1080)
            
            -- Use WorldToViewportPoint (ViewportFrame cameras use this, not WorldToScreenPoint)
            local previewViewportSize = items.viewportframe.AbsoluteSize
            if previewViewportSize.X <= 0 or previewViewportSize.Y <= 0 then return end
            
            local screenPoint, onScreen = camera:WorldToViewportPoint(root.Position)
            
            if not onScreen or screenPoint.Z <= 0 then 
                -- Character is off-screen, hide ESP elements
                if objs["box_handler"] then objs["box_handler"].Visible = false end
                return 
            end
            
            -- Convert viewport coordinates (0-1) to pixel coordinates within preview viewport
            local posX = screenPoint.X * previewViewportSize.X
            local posY = screenPoint.Y * previewViewportSize.Y
            
            -- Calculate box size using EXACT same method as actual ESP
            -- Actual ESP: local scaleFactor = (size * currentCamera.ViewportSize.Y) / (pos.Z * 2)
            -- CRITICAL: Use game camera viewport size for scale factor, not preview viewport size!
            local size = root.Size.Y
            local scaleFactor = (size * gameViewportSize.Y) / (screenPoint.Z * 2)
            local boxWidth = 3 * scaleFactor
            local boxHeight = 4.5 * scaleFactor
            
            -- Store character center position (pos.X, pos.Y) for text positioning
            if not objs["holder"] then return end
            local holderPos = objs["holder"].AbsolutePosition
            local viewportPos = items.viewportframe.AbsolutePosition
            
            -- Calculate positions relative to holder (accounting for viewport position within holder)
            local holderRelativeX = posX - (holderPos.X - viewportPos.X)
            local holderRelativeY = posY - (holderPos.Y - viewportPos.Y)
            
            -- Position box at character's screen position (EXACTLY like actual ESP: pos.X - w/2, pos.Y - h/2)
            objs["box_handler"].Position = UDim2.new(0, holderRelativeX - boxWidth / 2, 0, holderRelativeY - boxHeight / 2)
            objs["box_handler"].Size = UDim2.new(0, boxWidth, 0, boxHeight)
            objs["box_handler"].Visible = true
            
            -- Store positions for use in refresh_elements (matching actual ESP coordinate system)
            -- These are the character center coordinates (pos.X, pos.Y) relative to holder
            cfg._posX = holderRelativeX  -- Character center X (like pos.X in actual ESP)
            cfg._posY = holderRelativeY  -- Character center Y (like pos.Y in actual ESP)
            cfg._boxX = holderRelativeX - boxWidth / 2  -- Box left edge
            cfg._boxY = holderRelativeY - boxHeight / 2  -- Box top edge
            cfg._boxW = boxWidth
            cfg._boxH = boxHeight
        end

        cfg.change_health = function()
            if not cfg.character_model then return end
            
            local humanoid = cfg.character_model:FindFirstChild("Humanoid")
            if not humanoid then return end
            
            local health = math.clamp(humanoid.Health, 0, humanoid.MaxHealth)
            local maxHealth = humanoid.MaxHealth
            local healthRatio = health / maxHealth
            
            -- Update health bar position and size (matching actual ESP)
            if objects["healthbar"] and objects["behind_healthbar"] and cfg._posX and cfg._posY and cfg._boxW and cfg._boxH then
                local healthBarX = cfg._posX - cfg._boxW / 2 - 5
                local healthBarTop = cfg._posY - cfg._boxH / 2
                local healthBarHeight = cfg._boxH * healthRatio
                local healthBarY = healthBarTop + cfg._boxH * (1 - healthRatio)
                
                -- Update healthbar position and size
                objects["healthbar"].Position = UDim2.new(0, healthBarX, 0, healthBarY)
                objects["healthbar"].Size = UDim2.new(0, 2, 0, healthBarHeight)
                
                -- Update health text if it exists
                if objects["health_text"] and objects["health_text"].Parent == objects["holder"] then
                    objects["health_text"].Text = tostring(math.floor(health))
                    if flags.esp_health_dynamic then
                        objects["health_text"].TextColor3 = Color3.fromHSV(healthRatio * 0.3, 1, 1)
                    end
                    -- Update health text position
                    local healthTextY = healthBarTop + cfg._boxH * (1 - healthRatio) + 3
                    objects["health_text"].Position = UDim2.new(0, cfg._posX - cfg._boxW / 2 - 18, 0, healthTextY)
                end
            end
        end 

