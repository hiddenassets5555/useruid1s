                        objects["BottomRightSide"].BackgroundTransparency = 0
                    end
                    if objects["BottomRightDown"] then
                        objects["BottomRightDown"].Visible = true
                        objects["BottomRightDown"].Position = UDim2.new(0, posX + w / 2, 0, posY + h / 2)
                        objects["BottomRightDown"].Size = UDim2.new(0, w / 5, 0, 1)
                        objects["BottomRightDown"].AnchorPoint = Vector2.new(1, 1)
                        objects["BottomRightDown"].BackgroundColor3 = boxColor
                        objects["BottomRightDown"].BackgroundTransparency = 0
                    end
                elseif showBox then
                    -- Full Bounding Boxes (4 segments) - EXACTLY matching actual ESP
                    local posX = cfg._posX or boxX  -- Character center X
                    local posY = cfg._posY or boxY  -- Character center Y
                    local boxLeft = posX - w / 2
                    local boxTop = posY - h / 2
                    
                    if objects["LeftTop"] then
                        objects["LeftTop"].Visible = true
                        objects["LeftTop"].Position = UDim2.new(0, boxLeft, 0, boxTop)
                        objects["LeftTop"].Size = UDim2.new(0, w, 0, 1)
                        objects["LeftTop"].AnchorPoint = Vector2.new(0, 0)
                        objects["LeftTop"].BackgroundColor3 = boxColor
                        objects["LeftTop"].BackgroundTransparency = 0
                    end
                    if objects["LeftSide"] then
                        objects["LeftSide"].Visible = true
                        objects["LeftSide"].Position = UDim2.new(0, boxLeft, 0, boxTop)
                        objects["LeftSide"].Size = UDim2.new(0, 1, 0, h)
                        objects["LeftSide"].AnchorPoint = Vector2.new(0, 0)
                        objects["LeftSide"].BackgroundColor3 = boxColor
                        objects["LeftSide"].BackgroundTransparency = 0
                    end
                    if objects["BottomSide"] then
                        objects["BottomSide"].Visible = true
                        objects["BottomSide"].Position = UDim2.new(0, boxLeft, 0, posY + h / 2)
                        objects["BottomSide"].Size = UDim2.new(0, w, 0, 1)
                        objects["BottomSide"].AnchorPoint = Vector2.new(0, 1)
                        objects["BottomSide"].BackgroundColor3 = boxColor
                        objects["BottomSide"].BackgroundTransparency = 0
                    end
                    if objects["RightSide"] then
                        objects["RightSide"].Visible = true
                        objects["RightSide"].Position = UDim2.new(0, posX + w / 2 - 1, 0, boxTop)
                        objects["RightSide"].Size = UDim2.new(0, 1, 0, h)
                        objects["RightSide"].AnchorPoint = Vector2.new(0, 0)
                        objects["RightSide"].BackgroundColor3 = boxColor
                        objects["RightSide"].BackgroundTransparency = 0
                    end
                    
                    -- Hide unused corner segments
                    if objects["BottomDown"] then objects["BottomDown"].Visible = false end
                    if objects["RightTop"] then objects["RightTop"].Visible = false end
                    if objects["BottomRightSide"] then objects["BottomRightSide"].Visible = false end
                    if objects["BottomRightDown"] then objects["BottomRightDown"].Visible = false end
                end
            else
                objects["box_handler"].Parent = library.cache
                -- Hide all segments
                if objects["LeftTop"] then objects["LeftTop"].Visible = false end
                if objects["LeftSide"] then objects["LeftSide"].Visible = false end
                if objects["BottomSide"] then objects["BottomSide"].Visible = false end
                if objects["BottomDown"] then objects["BottomDown"].Visible = false end
                if objects["RightTop"] then objects["RightTop"].Visible = false end
                if objects["RightSide"] then objects["RightSide"].Visible = false end
                if objects["BottomRightSide"] then objects["BottomRightSide"].Visible = false end
                if objects["BottomRightDown"] then objects["BottomRightDown"].Visible = false end
            end
            objects["box_outline"].Parent = library.cache
            
            -- Health Bar - Position to the left of box (EXACTLY like actual ESP: pos.X - w/2 - 5)
            local healthBarEnabled = flags.esp_health_bar_dummy or false
            if objects["healthbar"] and objects["behind_healthbar"] then
                objects["healthbar"].Parent = (espEnabled and healthBarEnabled) and objects["holder"] or library.cache
                objects["behind_healthbar"].Parent = (espEnabled and healthBarEnabled) and objects["holder"] or library.cache
                
                if healthBarEnabled then
                    local c1 = getColor("esp_health_bar_c1", Color3.new(0, 1, 0))
                    local c2 = getColor("esp_health_bar_c2", Color3.new(1, 0, 0))
                    
                    -- Get health from character
                    local health = 100
                    local maxHealth = 100
                    if cfg.character_model then
                        local humanoid = cfg.character_model:FindFirstChild("Humanoid")
                        if humanoid then
                            health = math.clamp(humanoid.Health, 0, humanoid.MaxHealth)
                            maxHealth = humanoid.MaxHealth
                        end
                    end
                    local healthRatio = health / maxHealth
                    
                    -- Position health bar exactly like actual ESP: pos.X - w/2 - 5
                    if cfg._posX and cfg._posY and cfg._boxW and cfg._boxH then
                        local healthBarX = cfg._posX - cfg._boxW / 2 - 5
                        local healthBarTop = cfg._posY - cfg._boxH / 2
                        local healthBarHeight = cfg._boxH * healthRatio
                        local healthBarY = healthBarTop + cfg._boxH * (1 - healthRatio)
                        
                        -- Behind healthbar (full height background)
                        objects["behind_healthbar"].Visible = true
                        objects["behind_healthbar"].Position = UDim2.new(0, healthBarX, 0, healthBarTop)
                        objects["behind_healthbar"].Size = UDim2.new(0, 2, 0, cfg._boxH)
                        
                        -- Healthbar (actual health, positioned from bottom)
                        objects["healthbar"].Visible = true
                        objects["healthbar"].Position = UDim2.new(0, healthBarX, 0, healthBarY)
                        objects["healthbar"].Size = UDim2.new(0, 2, 0, healthBarHeight)
                    end
                    
                    -- Handle gradient (matching actual ESP)
                    if flags.esp_health_gradient then
                        if objects["healthbar_gradient"] then
                            objects["healthbar_gradient"].Enabled = true
                            objects["healthbar_gradient"].Color = ColorSequence.new{
                                ColorSequenceKeypoint.new(0, c1),
                                ColorSequenceKeypoint.new(1, c2)
                            }
                            objects["healthbar_gradient"].Offset = Vector2.new(0, healthRatio - 1)
                            objects["healthbar"].BackgroundColor3 = Color3.new(1, 1, 1)
                        else
                            objects["healthbar"].BackgroundColor3 = c1
                        end
                    else
                        if objects["healthbar_gradient"] then
                            objects["healthbar_gradient"].Enabled = false
                        end
                        objects["healthbar"].BackgroundColor3 = c1
                    end
                else
                    objects["healthbar"].Visible = false
                    objects["behind_healthbar"].Visible = false
                end
            end
            
            -- Skeleton (if exists)
            local sk = objects["skeleton"]
            if sk then
                sk.Parent = library.cache -- Skeleton not currently in ESP flags, keep hidden
                for _, line in ipairs(sk:GetChildren()) do
                    if line:IsA("Frame") then
                        line.BackgroundColor3 = ESP_SETTINGS and ESP_SETTINGS.SkeletonColor or Color3.new(1, 1, 1)
                    end
                end
            end
            
            -- Chams (matching actual ESP)
            if cfg.objects["chams"] then
                local chamsEnabled = flags.esp_chams_dummy or false
                local shouldShow = (espEnabled and chamsEnabled) and true or false
                
                if shouldShow and cfg.character_model then
                    cfg.objects["chams"].Enabled = true
                    cfg.objects["chams"].Adornee = cfg.character_model
                    cfg.objects["chams"].FillColor = getColor("esp_chams_c1", Color3.new(1, 0, 0))
                    cfg.objects["chams"].OutlineColor = getColor("esp_chams_c2", Color3.new(1, 1, 1))
                    
                    -- Handle transparency (matching actual ESP)
                    local fillTrans = 0.5
                    if type(flags.esp_chams_c1) == "table" and flags.esp_chams_c1.Transparency then
                        fillTrans = 1 - flags.esp_chams_c1.Transparency
                    end
                    local outlineTrans = 0
                    if type(flags.esp_chams_c2) == "table" and flags.esp_chams_c2.Transparency then
                        outlineTrans = 1 - flags.esp_chams_c2.Transparency
                    end
                    
                    if flags.esp_chams_thermal then
                        local breathe = math.abs(math.sin(tick() * 2))
                        cfg.objects["chams"].FillTransparency = fillTrans * breathe
                        cfg.objects["chams"].OutlineTransparency = outlineTrans * breathe
                    else
                        cfg.objects["chams"].FillTransparency = fillTrans
                        cfg.objects["chams"].OutlineTransparency = outlineTrans
                    end
                    
                    -- Set depth mode (matching actual ESP: AlwaysOnTop)
                    cfg.objects["chams"].DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                else
                    cfg.objects["chams"].Enabled = false
                end
            end
        end

        return setmetatable(cfg, library)
    end

