                        else
                            getgenv().crosshair.spin = false
                        end
                        if flags.visuals_crosshair_spin_speed then getgenv().crosshair.spin_speed = flags.visuals_crosshair_spin_speed end
                        
                        -- Sync Resize
                        if flags.visuals_crosshair_resize ~= nil then 
                            getgenv().crosshair.resize = flags.visuals_crosshair_resize 
                        else
                            getgenv().crosshair.resize = false
                        end
                        if flags.visuals_crosshair_resize_speed then getgenv().crosshair.resize_speed = flags.visuals_crosshair_resize_speed end
                        if flags.visuals_crosshair_max then getgenv().crosshair.resize_max = flags.visuals_crosshair_max end
                        if flags.visuals_crosshair_min then getgenv().crosshair.resize_min = flags.visuals_crosshair_min end
                    end
                end)
            end)
            
            -- Crosshair On Target Logic
            run.RenderStepped:Connect(function()
                 if not getgenv().crosshair then return end
                 local onTarget = library.flags.visuals_crosshair_ontarget
                 local target = getgenv().SilentAimTarget
                 local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
                 
                 local desiredPos = center
                 local activeTarget = false

                 if onTarget and target and target:FindFirstChild("Head") then
                      local head = target.Head
                      local pos, onScreen = camera:WorldToViewportPoint(head.Position)
                      
                      if onScreen then
                           desiredPos = Vector2.new(pos.X, pos.Y)
                           activeTarget = true
                      end
                 end

                 local lerpSpeed = 0.12 -- Smoothing factor (Lower = Slower/Smoother)

                 if activeTarget then
                      getgenv().crosshair.mode = 'custom'
                      local current = getgenv().crosshair.position or center
                      getgenv().crosshair.position = current:Lerp(desiredPos, lerpSpeed)
                 else
                      -- Return to center smoothly if currently custom
                      if getgenv().crosshair.mode == 'custom' then
                           local current = getgenv().crosshair.position or center
                           local dist = (current - center).Magnitude
                           
                           if dist < 2 then
                                getgenv().crosshair.mode = 'center'
                           else
                                getgenv().crosshair.position = current:Lerp(center, lerpSpeed)
                           end
                      elseif getgenv().crosshair.mode ~= 'center' then
                           -- Force center if not custom and not center (fallback)
                           getgenv().crosshair.mode = 'center'
                      end
                 end
            end)
