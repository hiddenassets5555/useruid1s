            -- Trail Logic
            do
                local trailEnabled = false
                local trailColor1 = Color3.fromRGB(227, 144, 191)
                local trailColor2 = Color3.fromRGB(227, 144, 191)
                local trailLifetime = 2.3

                local function updateTrailColor()
                     local char = PlayersService.LocalPlayer.Character
                     if not char then return end
                     local root = char:FindFirstChild("HumanoidRootPart")
                     if not root then return end
                     local trail = root:FindFirstChild("TraeTrail")
                     if trail then
                         trail.Color = ColorSequence.new(trailColor1, trailColor2)
                     end
                end

                local function updateTrail(state)
                    local char = PlayersService.LocalPlayer.Character
                    if not char then return end
                    local root = char:FindFirstChild("HumanoidRootPart")
                    if not root then return end

                    if state then
                        if not root:FindFirstChild("TraeTrail") then
                            local trail = Instance.new("Trail")
                            trail.Name = "TraeTrail"
                            trail.Parent = root

                            local att0 = Instance.new("Attachment", root)
                            att0.Name = "TraeTrailAtt0"
                            att0.Position = Vector3.new(0, 1, 0)

                            local att1 = Instance.new("Attachment", root)
                            att1.Name = "TraeTrailAtt1"
                            att1.Position = Vector3.new(0, -1, 0)

                            trail.Attachment0 = att0
                            trail.Attachment1 = att1
                            trail.Color = ColorSequence.new(trailColor1, trailColor2)
                            trail.Lifetime = trailLifetime
                            trail.Transparency = NumberSequence.new(0, 0)
                            trail.LightEmission = 0.2
                            trail.Brightness = 10
                            trail.WidthScale = NumberSequence.new{
                                NumberSequenceKeypoint.new(0, 0.1),
                                NumberSequenceKeypoint.new(1, 0)
                            }
                        else
                             updateTrailColor()
                        end
                    else
                        local trail = root:FindFirstChild("TraeTrail")
                        if trail then trail:Destroy() end
                        local att0 = root:FindFirstChild("TraeTrailAtt0")
                        if att0 then att0:Destroy() end
                        local att1 = root:FindFirstChild("TraeTrailAtt1")
                        if att1 then att1:Destroy() end
                    end
                end

                local trailRespawnConn

                local trailToggle = PlayerSection:toggle({
                    name = "Trail",
                    flag = "toggle_trail",
                    default = false,
                    callback = function(v)
                        trailEnabled = v
                        updateTrail(v)

                        if v then
                            if trailRespawnConn then trailRespawnConn:Disconnect() end
                            trailRespawnConn = PlayersService.LocalPlayer.CharacterAdded:Connect(function(newChar)
                                newChar:WaitForChild("HumanoidRootPart")
                                if trailEnabled then
                                    updateTrail(true)
                                end
                            end)
                        else
                            if trailRespawnConn then trailRespawnConn:Disconnect() end
                            trailRespawnConn = nil
                        end
                    end
                })

                trailToggle:colorpicker({
                    name = "Trail Color 1",
                    flag = "color_trail_1",
                    color = trailColor1,
                    callback = function(v)
                        trailColor1 = v
                        if trailEnabled then
                            updateTrailColor()
                        end
                    end
                })

                trailToggle:colorpicker({
                    name = "Trail Color 2",
                    flag = "color_trail_2",
                    color = trailColor2,
                    callback = function(v)
                        trailColor2 = v
                        if trailEnabled then
                            updateTrailColor()
                        end
                    end
                })
            end
        end

        do -- Left Column: See Through
            local SeeThroughSection = visualsLeft:section({name = "uwuflowstate>.<"})
            
            local stEnabled = false
            local stGlowEnabled = false
            local stVisibleColor = Color3.fromRGB(0, 0, 0)
            local stOccludedColor = Color3.fromRGB(227, 144, 191)
            local stVisibleTrans = 0.5
            local stOccludedTrans = 0
            
            local stModel
            local stHighlightOccluded
            local stHighlightVisible
            local stClones = {}
            local stConnection
            local stRespawnConn
            local stChildAddedConn
            
            local function updateGlow()
                for _, clone in pairs(stClones) do
                    if clone and clone:IsA("BasePart") then
                        if stGlowEnabled then
                            clone.Material = Enum.Material.Neon
                            clone.Color = stOccludedColor
                        else
                            clone.Material = Enum.Material.SmoothPlastic
                            clone.Color = Color3.new(1, 1, 1)
                        end
                    end
                end
            end
            
            local function cleanupST()
                if stConnection then stConnection:Disconnect() stConnection = nil end
                if stChildAddedConn then stChildAddedConn:Disconnect() stChildAddedConn = nil end
                
                for _, clone in pairs(stClones) do
                    if clone then clone:Destroy() end
                end
                table.clear(stClones)
                
                if stModel then stModel:Destroy() stModel = nil end
                
                local char = players.LocalPlayer.Character
                if char then
                    local h = char:FindFirstChild("SeeThroughHighlightVisible")
                    if h then h:Destroy() end
                end
            end
            
            local function createClone(part, parentModel)
                if not part:IsA("BasePart") then return nil end
                if part.Name == "HumanoidRootPart" then return nil end -- Ignore HumanoidRootPart
                
                local prevArchivable = part.Archivable
                part.Archivable = true
                local clone = part:Clone()
                part.Archivable = prevArchivable
                
                if not clone then return nil end

                for _, v in ipairs(clone:GetChildren()) do
                    if not v:IsA("SpecialMesh") then
                        v:Destroy()
                    else
                        v.TextureId = ""
                    end
                end
                
                if clone:IsA("MeshPart") then clone.TextureID = "" end
                
                clone.Transparency = 0
                clone.LocalTransparencyModifier = 0
                
                if stGlowEnabled then
                    clone.Material = Enum.Material.Neon
                    clone.Color = stOccludedColor
                else
                    clone.Material = Enum.Material.SmoothPlastic
                    clone.Color = Color3.new(1, 1, 1)
                end
                
                clone.Size = clone.Size * 0.9
                clone.CanCollide = false
                clone.CanTouch = false
                clone.CanQuery = false
                clone.CastShadow = false
                clone.Anchored = true
                clone.Massless = true
                clone.Parent = parentModel
                
                return clone
            end
            
            local function setupST(char)
                cleanupST() 
                if not char then return end
                
                -- Create Model for Occluded parts (seen through walls)
                stModel = Instance.new("Model")
                stModel.Name = "SeeThroughModel"
                stModel.Parent = workspace
                
                -- Highlight for Real Character (Visible parts)
                stHighlightVisible = Instance.new("Highlight")
                stHighlightVisible.Name = "SeeThroughHighlightVisible"
                stHighlightVisible.DepthMode = Enum.HighlightDepthMode.Occluded
                stHighlightVisible.FillColor = stVisibleColor
                stHighlightVisible.FillTransparency = stVisibleTrans
                stHighlightVisible.OutlineTransparency = 1
                stHighlightVisible.Parent = char
                
                -- Highlight for Cloned Model (Occluded parts seen through walls)
                stHighlightOccluded = Instance.new("Highlight")
                stHighlightOccluded.Name = "SeeThroughHighlightOccluded"
                stHighlightOccluded.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                stHighlightOccluded.FillColor = stOccludedColor
                stHighlightOccluded.FillTransparency = stOccludedTrans
                stHighlightOccluded.OutlineTransparency = 1
                stHighlightOccluded.Parent = stModel
                
                local function addClone(v)
                    if v:IsA("BasePart") or v:IsA("Accessory") then
                        local sourcePart = v
                        if v:IsA("Accessory") then 
                            sourcePart = v:WaitForChild("Handle", 5) 
                        end
                        
                        if sourcePart then
                             if stClones[sourcePart] then return end
                             local clone = createClone(sourcePart, stModel)
                             if clone then
                                 stClones[sourcePart] = clone
                             end
                        end
                    end
                end

                -- Clone existing parts
                for _, v in ipairs(char:GetChildren()) do
                    task.spawn(function() addClone(v) end)
                end
                
                -- Listen for new parts
                stChildAddedConn = char.ChildAdded:Connect(function(v)
                     task.spawn(function() addClone(v) end)
                end)
                
                -- Update loop
                stConnection = run.Heartbeat:Connect(function()
                    if not stEnabled then return end
                    for source, clone in pairs(stClones) do
                        if source and source.Parent and clone and clone.Parent then
                            clone.CFrame = source.CFrame
                        else
                            if clone then clone:Destroy() end
                            stClones[source] = nil
                        end
                    end
                end)
            end
            
